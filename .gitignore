__pycache__/
*.pyc
*.egg-info/
build/
dist/
results/
runs/
logs/
*.aux
*.log
*.out
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# CUDA/C++ build artifacts
*.o
*.so
.ninja_deps
.ninja_log
build.ninja
build_sm*/

# precompiled preamble formats (make fmt)
*.fmt

# core dumps + slurm stderr logs
core.[0-9]*
*.err

# benchmark output: JSONL records and the LaTeX fragments emitted from them.
# `results/` above already matches this, but the measurement package names
# it explicitly so a future rename of that rule cannot silently start
# committing multi-megabyte sweep logs.
benchmarks/results/

# arXiv release trees: the sources are tracked;
# the upload archive and the test PDF are regenerated byte-identically from them.
publish/**/*.tar.gz
publish/**/*.pdf
asm_k27/

# Anonymous build bibliography is generated; the named source BBL is tracked.
papers/diagonal_equivalence/tmlr/*.bbl
